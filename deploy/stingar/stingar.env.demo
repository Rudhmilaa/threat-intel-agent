# Copy to stingar.env for local docker compose demo:
#   cp stingar.env.demo stingar.env

REMOTE_STORE_API_KEY=
REMOTE_STORE_BASE_URL=
REMOTE_STORE_ENABLED=false

API_HOST=http://stingarapi:8000
API_KEY=local-demo-api-key
CIF_CONFIDENCE=50
CIF_ENABLED=false
CIF_GROUP=stingar
CIF_HOST=
CIF_PROVIDER=stingar
CIF_TAGS=honeypot
CIF_TOKEN=
CLEANUP_AFTER_HOURS=168
CLEANUP_OLD_IMAGES=false
DEFAULT_ROWS_PER_PAGE=20
DOCKER_PASSWORD=
DOCKER_REPOSITORY=4warned
DOCKER_USERNAME=
FILE_ENABLED=false
FLUENTBIT_APP=stingar
FLUENTBIT_HOST=fluent-bit
FLUENTBIT_HOSTNAME=localhost
FLUENTBIT_PORT=24224
FLUENTD_APP=stingar
FLUENTD_HOST=fluentd
FLUENTD_KEY=
FLUENTD_LOCAL_PORT=24225
FLUENTD_PORT=24224
FLUENTD_REMOTE_HOST=
HONEYPOT_HEALTHCHECK_INTERVAL=60
HONEYPOT_HEALTHCHECK_TIMEOUT=10
IDS_RULES_AUTO_UPDATE_ENABLED=false
IDS_RULES_AUTO_UPDATE_INTERVAL=86400
IDS_RULES_CACHE_PATH=/tmp/ids-rules
IDS_RULES_FEED_DATE_RANGE=30d
INSTITUTION_NAME=Demo
PASSPHRASE=local-demo-passphrase
SALT=local-demo-salt
STINGAR_SERVICE_URL=https://localhost
SYSLOG_ENABLED=false
SYSLOG_HOST=
SYSLOG_HOSTNAME=localhost
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp
SYSLOG_SEVERITY=info
TAGS=honeypot
THEME_LIGHT_BASE_COLOR=#ffffff
UI_HOSTNAME=localhost
UPDATE_CHECK_INTERVAL=86400
UPDATE_MODE=manual
UPDATE_SERVICE_ENABLED=false
UPDATE_WINDOW_END=06:00
UPDATE_WINDOW_START=02:00
USER_DOC_URL=/docs

REDIS_URL=redis://redis:6379/0
SCANNER_INVENTORY_BACKEND=redis
SCANNER_LITE_URL=http://scanner-lite:8091
STINGAR_CLIENT_ID=scanner-lite
SCANNER_LITE_INGEST_URL=http://scanner-lite:8091/ingest/fluentd
